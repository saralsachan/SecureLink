{
  "manifest_version": 3,
  "name": "SecureLink",
  "description": "Privacy-first browser agent extension skeleton.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "SecureLink"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/content.js"]
    }
  ],
  "permissions": ["activeTab", "scripting", "storage"]
}
